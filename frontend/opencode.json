{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "FIGMA_API_KEY": "{file:figma-api-key}"
      }
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "enabled": true,
      "environment": {}
    }
  }
}
