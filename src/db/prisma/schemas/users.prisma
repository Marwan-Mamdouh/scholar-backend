model User {
  id                  Int                            @id @default(autoincrement())
  email               String                         @unique
  password            String
  role                UserRole
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  
  // Relations
  profile             Profile?
  jobApplications     JobApplication[]
  feedbacks           Feedback[]
  projectApplications GraduationProjectApplication[]


  //the Table will be named "users" in the postgresql 
  @@map("users")
}